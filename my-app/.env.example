# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL of the site (used for sitemap, emails, OG tags)
SITE_URL=https://example.com

# ----------------------------------------------------------------------------
# Database
# Leave MONGODB_URI empty to use the built-in embedded JSON store (data/db.json)
# For production use MongoDB (Atlas or self-hosted):
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/mycompany
DB_TIMEOUT_MS=6000
# Force the embedded store even when MONGODB_URI is set
# FORCE_FILE_DB=1
DATA_DIR=./data

# ----------------------------------------------------------------------------
# Security  (REQUIRED in production)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_generate_96_hex_chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://example.com
RATE_LIMIT_MAX=600
FORM_LIMIT_MAX=30

# ----------------------------------------------------------------------------
# First administrator (created on first boot only)
# ----------------------------------------------------------------------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@12345

# ----------------------------------------------------------------------------
# Media storage – optional. Falls back to local disk (public/uploads).
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
# Insert demo content on first boot (never in production)
SEED_DEMO=false
BACKUP_DIR=./data/backups
